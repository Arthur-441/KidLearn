rules_version = '2';
service cloud.firestore {
  match /databases/{database}/documents {
    match /{document=**} {
      allow read, write: if false;
    }

    function isValidId(id) {
      return id is string && id.size() <= 128 && id.matches('^[a-zA-Z0-9_\\-]+$');
    }

    function incoming() { return request.resource.data; }
    function existing() { return resource.data; }
    function isSignedIn() { return request.auth != null; }

    function isAdmin() {
      return isSignedIn() && exists(/databases/$(database)/documents/users/$(request.auth.uid)) && get(/databases/$(database)/documents/users/$(request.auth.uid)).data.get('role', 'user') == 'admin';
    }

    match /adminUsers/{userId} {
      allow read, write: if isAdmin();
    }

    match /premiumCodes/{codeId} {
      allow read: if isSignedIn();
      allow update: if isSignedIn() &&
        (incoming().diff(existing()).affectedKeys().hasOnly(['status', 'redeemed', 'activatedBy', 'activatedAt']) &&
        incoming().status == 'redeemed' &&
        incoming().redeemed == true &&
        incoming().activatedBy is string && 
        incoming().activatedAt == request.time) || isAdmin();
      allow create, delete: if isAdmin();
    }

    match /activationCodes/{codeId} {
      allow read: if isSignedIn();
      allow update: if (isSignedIn() &&
        existing().get('used', false) == false &&
        incoming().diff(existing()).affectedKeys().hasOnly(['used', 'usedBy', 'usedAt']) &&
        incoming().get('used', false) == true &&
        incoming().get('usedBy', '') is string && 
        incoming().get('usedAt', request.time) == request.time) || isAdmin();
      
      allow create, delete: if isAdmin();
    }

    match /subscriptions/{subscriptionId} {
      allow read: if isSignedIn() && (request.auth.uid == subscriptionId || isAdmin());
      allow write: if isAdmin();
    }

    function isValidUserCreate(data) {
      return data.keys().hasAll(['username', 'email', 'stars', 'badges', 'gamesPlayed', 'createdAt', 'role', 'isPremium', 'subscriptionEndDate']) &&
             data.keys().size() == 9 &&
             data.username is string && data.username.size() > 0 && data.username.size() <= 64 &&
             data.email is string && data.email.size() > 0 && data.email.size() <= 128 &&
             data.stars == 0 &&
             data.badges is list && data.badges.size() == 0 &&
             data.gamesPlayed == 0 &&
             data.role == 'user' &&
             data.isPremium == false &&
             data.createdAt == request.time;
    }

    function isValidChildCreate(data) {
      return data.keys().hasAll(['name', 'avatar', 'stars', 'badges', 'gamesPlayed', 'dailyMessage', 'createdAt']) &&
             data.keys().size() == 7 &&
             data.name is string && data.name.size() > 0 && data.name.size() <= 64 &&
             data.avatar is string && data.avatar.size() <= 10 &&
             data.stars is number && data.stars == 0 &&
             data.badges is list && data.badges.size() == 0 &&
             data.gamesPlayed is number && data.gamesPlayed == 0 &&
             data.dailyMessage is string && data.dailyMessage.size() <= 500 &&
             data.createdAt == request.time;
    }

    function isValidGameResultCreate(data) {
      return data.keys().hasAll(['subject', 'score', 'total', 'starsEarned', 'issues', 'createdAt', 'timeTaken']) &&
             data.keys().size() == 7 &&
             data.subject is string && data.subject.size() > 0 && data.subject.size() <= 32 &&
             data.score is number && data.score >= 0 &&
             data.total is number && data.total > 0 &&
             data.starsEarned is number && data.starsEarned >= 0 &&
             data.issues is list && data.issues.size() <= 50 &&
             data.timeTaken is number && data.timeTaken >= 0 &&
             data.createdAt == request.time;
    }

    match /users/{userId} {
      allow get: if isSignedIn() && isValidId(userId) && (request.auth.uid == userId || isAdmin());
      allow list: if isAdmin();

      allow create: if isSignedIn() && isValidId(userId) && request.auth.uid == userId &&
                    isValidUserCreate(incoming());

      allow update: if (isSignedIn() && isValidId(userId) && request.auth.uid == userId && (
        (incoming().diff(existing()).affectedKeys().hasOnly(['stars', 'gamesPlayed'])) ||
        (incoming().diff(existing()).affectedKeys().hasOnly(['stars', 'gamesPlayed', 'badges'])) ||
        (incoming().diff(existing()).affectedKeys().hasOnly(['username']))
      ) &&
      incoming().get('stars', 0) is number &&
      incoming().get('gamesPlayed', 0) is number &&
      incoming().get('badges', []) is list && incoming().get('badges', []).size() <= 50) || 
      (isAdmin() && incoming().diff(existing()).affectedKeys().hasOnly(['role', 'isPremium', 'subscriptionEndDate']) &&
       incoming().get('role', 'user') is string &&
       incoming().get('isPremium', false) is bool);

      match /children/{childId} {
        allow get: if isSignedIn() && isValidId(userId) && isValidId(childId) && (request.auth.uid == userId || isAdmin());
        allow list: if (isSignedIn() && isValidId(userId) && request.auth.uid == userId) || isAdmin();
        
        allow create: if isSignedIn() && isValidId(userId) && isValidId(childId) && request.auth.uid == userId &&
                         isValidChildCreate(incoming());

        allow update: if (isSignedIn() && isValidId(userId) && isValidId(childId) && request.auth.uid == userId && (
          (incoming().diff(existing()).affectedKeys().hasOnly(['dailyMessage', 'stars', 'gamesPlayed', 'badges', 'name', 'avatar', 'lastLoginDate', 'streak', 'dailyStars', 'dailyGames', 'dailyBadges', 'quest1Claimed', 'quest2Claimed', 'quest3Claimed', 'questCompleted']) &&
          incoming().get('stars', 0) is number &&
          incoming().get('gamesPlayed', 0) is number &&
          incoming().get('dailyMessage', "") is string && incoming().get('dailyMessage', "").size() <= 500 &&
          incoming().get('badges', []) is list && incoming().get('badges', []).size() <= 50) ||
          (incoming().diff(existing()).affectedKeys().hasOnly(['isPremium', 'premiumActivatedAt', 'activationCode', 'premiumExpireAt']) &&
          incoming().get('isPremium', false) == true &&
          incoming().get('premiumActivatedAt', request.time) == request.time &&
          incoming().get('premiumExpireAt', request.time) is timestamp &&
          incoming().get('activationCode', '') is string)
        )) || (isAdmin() && incoming().diff(existing()).affectedKeys().hasOnly(['isPremium']));
        
        allow delete: if (isSignedIn() && isValidId(userId) && isValidId(childId) && request.auth.uid == userId) || isAdmin();

        match /results/{resultId} {
          allow get: if isSignedIn() && isValidId(userId) && isValidId(childId) && isValidId(resultId) && request.auth.uid == userId;
          allow list: if isSignedIn() && isValidId(userId) && isValidId(childId) && request.auth.uid == userId;
          
          allow create: if isSignedIn() && isValidId(userId) && isValidId(childId) && isValidId(resultId) && request.auth.uid == userId &&
                           isValidGameResultCreate(incoming());
        }
      }
    }
  }
}
